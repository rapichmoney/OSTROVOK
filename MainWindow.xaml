<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopIsland" x:Class="DesktopIsland.MainWindow" Title="Desktop Island" Width="360" Height="44" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" MouseEnter="Expand" MouseLeave="Collapse" AllowDrop="True" Drop="ReceiveFiles" DragOver="FilesOver" PreviewKeyDown="WindowKeyDown" PreviewMouseMove="CompactHover">
  <Grid>
  <Border x:Name="Shell" Background="#181A1D" BorderBrush="#363B43" BorderThickness="1" CornerRadius="0,0,28,28" Padding="14,4" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="HeaderRow" Height="34"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="Header" Margin="4,0" MouseLeftButtonDown="MoveIsland">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="CompactClockGroup" Orientation="Horizontal" VerticalAlignment="Center">
          <Canvas x:Name="IdleClockDial" Width="20" Height="20" VerticalAlignment="Center">
            <Ellipse Width="20" Height="20" Fill="#0CFFFFFF" Stroke="#8393A5" StrokeThickness="1"/>
            <Line X1="10" Y1="10" X2="10" Y2="6" Stroke="#F0F1F3" StrokeThickness="1.8" StrokeEndLineCap="Round"><Line.RenderTransform><RotateTransform x:Name="IdleHourHand" CenterX="10" CenterY="10"/></Line.RenderTransform></Line>
            <Line X1="10" Y1="10" X2="10" Y2="3.5" Stroke="#F0F1F3" StrokeThickness="1.4" StrokeEndLineCap="Round"><Line.RenderTransform><RotateTransform x:Name="IdleMinuteHand" CenterX="10" CenterY="10"/></Line.RenderTransform></Line>
            <Line X1="10" Y1="11.5" X2="10" Y2="2" Stroke="{StaticResource Accent}" StrokeThickness="1" StrokeEndLineCap="Round"><Line.RenderTransform><RotateTransform x:Name="IdleSecondHand" CenterX="10" CenterY="10"/></Line.RenderTransform></Line>
            <Ellipse Width="3" Height="3" Canvas.Left="8.5" Canvas.Top="8.5" Fill="{StaticResource Accent}"/>
          </Canvas>
          <TextBlock x:Name="Clock" FontSize="17" FontWeight="SemiBold" Margin="0,1,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Border x:Name="CompactArtworkFrame" Width="26" Height="26" CornerRadius="6" Background="#46474B" VerticalAlignment="Center" Visibility="Collapsed" ClipToBounds="True">
          <Grid><Path Data="M 6,19 L 6,7 L 19,4 L 19,16 M 6,19 C 6,23 0,23 0,19 C 0,15 6,15 6,19 M 19,16 C 19,20 13,20 13,16 C 13,12 19,12 19,16" Stroke="{StaticResource Ink}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
          <Image x:Name="CompactArtwork" Width="26" Height="26" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,26,26" RadiusX="6" RadiusY="6"/></Image.Clip></Image></Grid>
        </Border>
        <Grid x:Name="CompactTextHost" Grid.Column="2" Margin="12,0" ClipToBounds="True"><Grid x:Name="CompactTextContent">
        <TextBlock x:Name="CompactTrack" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="CompactLyricFill" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid><Image x:Name="CompactTextSnapshot" Visibility="Collapsed" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
        <Canvas x:Name="CompactPlaybackBars" Grid.Column="4" Width="22" Height="18" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Воспроизводится">
          <Rectangle Canvas.Left="0" Canvas.Top="2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle Canvas.Left="6" Canvas.Top="2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle Canvas.Left="12" Canvas.Top="2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.7"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle Canvas.Left="18" Canvas.Top="2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
        </Canvas>
        <Grid x:Name="CompactNoticeHost" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Visibility="Collapsed" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="OpenClipboardNotice">
          <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Path x:Name="CompactNoticeIcon" Width="18" Height="18" Stretch="Uniform" Stroke="#A8C4D4" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"/>
          <TextBlock x:Name="CompactNotice" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Уведомление буфера обмена"/>
        </Grid>
        <Grid x:Name="CompactTelegramHost" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Visibility="Collapsed" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="OpenTelegramNotice">
          <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Path Width="18" Height="18" Stretch="Uniform" Stroke="#A8C4D4" StrokeThickness="1.5" Data="M 2,10 L 23,2 L 17,23 L 11,15 L 2,10 Z M 11,15 L 23,2"/>
          <TextBlock x:Name="CompactTelegramText" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <Button x:Name="IdleDateBadge" Grid.Column="4" Style="{StaticResource QuietButton}" Background="Transparent" BorderThickness="0" Padding="0,3" VerticalAlignment="Center" Click="OpenCompactCalendar" ToolTip="Открыть календарь" AutomationProperties.Name="Открыть календарь">
          <StackPanel Orientation="Horizontal"><TextBlock x:Name="IdleDateCaption" Visibility="Collapsed"/><TextBlock x:Name="Battery" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/></StackPanel>
        </Button>
        <Border x:Name="KeyboardBadge" Grid.Column="1" MinWidth="28" Height="20" Margin="8,0,0,0" Padding="5,0" Background="#4B4D50" BorderBrush="#5B5D61" BorderThickness="1" CornerRadius="5" VerticalAlignment="Center" ToolTip="Раскладка клавиатуры">
          <TextBlock x:Name="KeyboardText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="UsbPhoneStatus" Style="{StaticResource QuietButton}" Background="Transparent" BorderThickness="0" Padding="3,2" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" Click="OpenIphoneStatus" ToolTip="iPhone подключён по USB" AutomationProperties.AutomationId="UsbPhoneStatus" AutomationProperties.Name="iPhone подключён по USB">
          <Path Width="12" Height="17" Stretch="Uniform" Stroke="{StaticResource Ink}" StrokeThickness="1.5" Data="M 7,1 L 17,1 Q 20,1 20,4 L 20,22 Q 20,25 17,25 L 7,25 Q 4,25 4,22 L 4,4 Q 4,1 7,1 Z M 9,4 L 15,4 M 10,22 L 14,22"/>
        </Button>
        <StackPanel x:Name="CompactWeatherGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="CompactWeatherGlyph" Text="☁" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <TextBlock x:Name="CompactWeather" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        </StackPanel>
      </Grid>
      <Grid x:Name="CompactCard" Grid.Row="0" Margin="12,8" Visibility="Collapsed" ClipToBounds="True" MouseLeftButtonDown="MoveIsland">
        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Path x:Name="CompactCardGhostIcon" Grid.RowSpan="2" Width="20" Height="20" Margin="2,0,0,0" HorizontalAlignment="Left" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.4" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"/>
        <Path x:Name="CompactCardIcon" Grid.RowSpan="2" Width="20" Height="20" Margin="2,0,0,0" HorizontalAlignment="Left" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.4" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
        <TextBlock x:Name="CompactCardTitle" Grid.Column="1" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock x:Name="CompactCardText" Grid.Row="1" Grid.Column="1" FontSize="13" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <StackPanel Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
        <Button x:Name="UpdateLaterButton" Content="Позже" Click="PostponeAppUpdate" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Padding="10,5" Height="30" VerticalAlignment="Center" Visibility="Collapsed"/>
        <Button x:Name="CompactCardAction" Content="Буфер" Style="{StaticResource Primary}" Background="#F0F1F3" Foreground="#202124" Margin="0" Padding="10,5" MinWidth="64" Height="30" VerticalAlignment="Center" Click="CompactCardActionClick">
          <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
        </Button>
        </StackPanel>
        <TextBlock x:Name="NoticeQueueCount" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="11" Foreground="{StaticResource Secondary}" IsHitTestVisible="False"/>
      </Grid>
      <Border x:Name="NoticeLifetime" Grid.Row="0" Height="2" Margin="24,0,24,0" VerticalAlignment="Bottom" Background="#61717F" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0,0"><Border.RenderTransform><ScaleTransform x:Name="NoticeLifetimeScale"/></Border.RenderTransform></Border>
      <TextBlock x:Name="GamepadChargeText" Grid.Row="3" Margin="12,2" Foreground="{StaticResource Secondary}" FontSize="11" Visibility="Collapsed" TextWrapping="Wrap"/>
      <Image x:Name="CompactSnapshot" Grid.Row="0" Visibility="Collapsed" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <Path x:Name="FlyingTelegramPlane" Grid.Row="0" Panel.ZIndex="20" Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.4" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Border x:Name="ClipboardNotice" Grid.Row="1" Background="#202A33" BorderBrush="#3D5262" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,8,4,0" Visibility="Collapsed">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Закрыть" Click="DismissClipboardNotice" Padding="6,2"/>
            <Path x:Name="ClipboardNoticeIcon" DockPanel.Dock="Left" Width="18" Height="18" Stretch="Uniform" Stroke="#A8C4D4" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0"/>
            <TextBlock x:Name="ClipboardNoticeTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"><TextBlock x:Name="ClipboardNoticeText" TextWrapping="Wrap" FontSize="13"/></ScrollViewer>
          <Button x:Name="CopyNoticeTranslation" Content="Скопировать перевод" Click="CopyCurrentTranslation" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="6,3" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <Border x:Name="TelegramNotice" Grid.Row="1" Background="#202A33" BorderBrush="#3D5262" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,8,4,0" Visibility="Collapsed">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Закрыть" Click="DismissTelegramNotice" Padding="6,2"/>
            <TextBlock x:Name="SocialNoticeSource" DockPanel.Dock="Left" Text="Telegram" Foreground="{StaticResource Secondary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TelegramNoticeTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"><TextBlock x:Name="TelegramNoticeText" TextWrapping="Wrap" FontSize="13"/></ScrollViewer>
          <Button Content="Открыть источник" Click="OpenTelegram" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="6,3"/>
        </StackPanel>
      </Border>
      <Grid x:Name="Body" Grid.Row="2" Visibility="Collapsed" Margin="12,16,12,12" ClipToBounds="True">
        <local:ContentPages x:Name="ContentTabs" Margin="0" Background="Transparent" BorderThickness="0">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <ContentPresenter ContentSource="SelectedContent"/>
            </ControlTemplate>
          </TabControl.Template>
          <TabItem>
            <Grid>
              <Grid x:Name="MediaPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Visibility="Collapsed">
                  <TextBlock Text="Музыка" Style="{StaticResource Heading}" Visibility="Collapsed"/>
                  <TextBlock x:Name="MediaSource" Style="{StaticResource MutedText}" Text="Плееры Windows" Visibility="Collapsed"/>
                  <ComboBox x:Name="Players" SelectionChanged="SelectPlayer" Margin="0,6,0,0" AutomationProperties.AutomationId="Players"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,0">
                  <Grid x:Name="TrackIdentity" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="112"/>
                      <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" Background="#252930" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Grid x:Name="ArtworkViewport" Width="96" Height="96" ClipToBounds="True">
                        <Grid.Clip>
                          <RectangleGeometry Rect="0,0,96,96" RadiusX="6" RadiusY="6"/>
                        </Grid.Clip>
                        <Path x:Name="ArtFallback" Data="M 34,62 L 34,28 L 64,22 L 64,56 M 34,29 L 64,23 M 34,62 C 34,74 16,74 16,64 C 16,54 34,54 34,62 M 64,56 C 64,68 46,68 46,58 C 46,48 64,48 64,56" Stroke="#8C9BA8" StrokeThickness="2" Stretch="None"/>
                        <Image x:Name="Artwork" Width="96" Height="96" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="TrackTitle" Text="Ничего не играет" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58"/>
                      <TextBlock x:Name="TrackArtist" Text="Откройте музыку или видео в плеере" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                  <Slider x:Name="Timeline" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Margin="0,16,0,0"  ValueChanged="PreviewSeekTime" AutomationProperties.AutomationId="Timeline"/>
                  <DockPanel>
                    <TextBlock x:Name="Elapsed" Text="0:00" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="DurationText" Text="0:00" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="YandexDislikeButton" Visibility="Collapsed" Click="RateYandexTrack" Tag="dislike" ToolTip="Не нравится — исключить трек из волны" AutomationProperties.Name="Не нравится" Style="{StaticResource QuietButton}" Padding="10" Margin="0,0,8,0">
                      <Path x:Name="YandexDislikeIcon" Data="{StaticResource Yandex_dislike_xs}" Fill="{StaticResource Secondary}" Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="PreviousButton" Click="Previous" ToolTip="Предыдущий трек" AutomationProperties.Name="Предыдущий трек" Style="{StaticResource QuietButton}" Padding="12,10">
                      <Path Data="M 0,0 L 0,16 M 16,0 L 4,8 L 16,16 Z" Stroke="#F0F1F3" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="PlayButton" Click="TogglePlayback" Margin="16,0" MinWidth="48" Width="48" Height="48" AutomationProperties.AutomationId="PlayButton" AutomationProperties.Name="Воспроизвести" ToolTip="Воспроизвести" Style="{StaticResource Primary}" Background="#E9EDF0" ContentTemplate="{x:Null}" Padding="12">
                      <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="24"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                      <Path x:Name="PlaybackIcon" Data="M 5,2 L 19,12 L 5,22 Z" Fill="#151C23" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="NextButton" Click="Next" ToolTip="Следующий трек" AutomationProperties.Name="Следующий трек" Style="{StaticResource QuietButton}" Padding="12,10">
                      <Path Data="M 16,0 L 16,16 M 0,0 L 12,8 L 0,16 Z" Stroke="#F0F1F3" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="YandexLikeButton" Visibility="Collapsed" Click="RateYandexTrack" Tag="like" ToolTip="Нравится — добавить в «Мне нравится»" AutomationProperties.Name="Нравится" Style="{StaticResource QuietButton}" Padding="10" Margin="8,0,0,0">
                      <Path x:Name="YandexLikeIcon" Data="{StaticResource Yandex_like_xs}" Fill="{StaticResource Secondary}" Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                  </StackPanel>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,20,0,12">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                  </Grid.RowDefinitions>
                  <DockPanel Margin="0,0,0,10">
                    
                    
                    
                    <Button x:Name="FollowLyricsButton" DockPanel.Dock="Right" Content="К текущей строке" Visibility="Collapsed" Style="{StaticResource QuietButton}" Padding="8,4" Click="ResumeLyricsFollow"/><TextBlock x:Name="LyricsStatus" Text="Текст песни появится при воспроизведении" Foreground="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ScrollViewer x:Name="LyricsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LyricsLines" Margin="0,4,10,18"/>
                  </ScrollViewer>
                </Grid>
                <Grid Grid.Row="3" Margin="0,8,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Button x:Name="MuteButton" Click="ToggleMute" Style="{StaticResource QuietButton}" Padding="0,6,12,6" AutomationProperties.Name="Выключить звук"><Path x:Name="VolumeGlyph" Data="M 2,8 L 7,8 L 13,3 L 13,21 L 7,16 L 2,16 Z M 17,7 C 21,10 21,14 17,17" Stroke="{StaticResource Secondary}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/></Button>
  <Slider x:Name="Volume" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="VolumeChanged" AutomationProperties.AutomationId="Volume"/>
  <TextBlock x:Name="VolumeText" Grid.Column="2" Margin="12,0,0,0" MinWidth="34" FontSize="11" Foreground="#929AA5" VerticalAlignment="Center" TextAlignment="Right"/>
</Grid>
              </Grid>
              <Grid x:Name="HomePanel" Margin="6,5,6,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="HomeClock" FontSize="42" FontWeight="SemiBold"/>
                  <TextBlock x:Name="HomeDate" Foreground="{StaticResource Secondary}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                  <Button Click="OpenSound" Background="Transparent" BorderThickness="0" Padding="0,6" HorizontalContentAlignment="Stretch" ToolTip="Настройки звука Windows">
                    <TextBlock x:Name="AudioDeviceText" Text="Устройство вывода Windows" TextTrimming="CharacterEllipsis" MaxWidth="226" FontSize="12"/>
                  </Button>
                  <DockPanel>
                    <TextBlock Text="Громкость" FontSize="11" Foreground="{StaticResource Secondary}"/>
                    <TextBlock x:Name="IdleVolumeText" HorizontalAlignment="Right" FontSize="11"/>
                  </DockPanel>
                  <Slider x:Name="IdleVolume" Minimum="0" Maximum="100" ValueChanged="VolumeChanged"/>
                </StackPanel>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Полка файлов" Style="{StaticResource Heading}"/>
                <TextBlock Text="Оригиналы остаются в своих папках" Style="{StaticResource MutedText}"/>
              </StackPanel>
              <ListBox x:Name="Shelf" Grid.Row="1" Margin="0,8,0,6" MouseDoubleClick="OpenShelf" PreviewMouseLeftButtonDown="ShelfDragStart" PreviewMouseMove="DragShelf" AutomationProperties.AutomationId="Shelf" MaxHeight="178">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Width="82" ToolTip="{Binding Path}">
                      <Path Data="{Binding Icon}" Stroke="#E3E3E3" StrokeThickness="1.4" Height="36" Width="32" Stretch="Uniform" Margin="0,4,0,8"/>
                      <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Row="1" Background="#082F3944" CornerRadius="8" Margin="0,12,0,12" IsHitTestVisible="False">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=Shelf}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel VerticalAlignment="Center" Margin="20"><Path Data="M 2,6 L 9,6 L 11,9 L 22,9 L 22,21 L 2,21 Z" Stroke="{StaticResource Muted}" StrokeThickness="1.5" Stretch="Uniform" Width="28" Height="24" HorizontalAlignment="Center" Margin="0,0,0,12"/><TextBlock Text="Перетащите сюда файлы" FontSize="14" HorizontalAlignment="Center"/></StackPanel>
              </Border>
              <StackPanel Grid.Row="2" x:Name="ShelfActions">
                <UniformGrid Columns="2" Margin="0,0,0,8">
                  <Button Content="Добавить файлы" Click="AddFiles" Margin="0,0,4,0"/>
                  <Button Content="Добавить ссылку" Click="AddShelfLink" Margin="4,0,0,0"/>
                </UniformGrid>
                <UniformGrid Columns="3">
